pipeline {
    agent any

    environment {
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend Test') {
            steps {
                sh '''
                    cd "$WORKSPACE/back-end"
                    mvn test
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    docker build -t faizan715/employee-backend:$IMAGE_TAG ./back-end
                    docker build -t faizan715/employee-frontend:$IMAGE_TAG ./front-end
                '''
            }
        }

        stage('Push Docker Images') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin

                        docker push faizan715/employee-backend:$IMAGE_TAG
                        docker push faizan715/employee-frontend:$IMAGE_TAG

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'kind-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        echo "Checking Kubernetes connection..."
                        kubectl get nodes

                        echo "Deploying database..."
                        kubectl apply -f k8s/database/ -n employee-app

                        echo "Applying backend resources..."
                        kubectl apply -f k8s/backend/ -n employee-app

                        echo "Applying frontend resources..."
                        kubectl apply -f k8s/frontend/ -n employee-app

                        echo "Loading versioned images into Kind..."
                        kind load docker-image faizan715/employee-backend:$IMAGE_TAG --name employee--devops
                        kind load docker-image faizan715/employee-frontend:$IMAGE_TAG --name employee--devops

                        echo "Updating deployments to image version $IMAGE_TAG..."

                        kubectl set image deployment/backend \
                            backend=faizan715/employee-backend:$IMAGE_TAG \
                            -n employee-app

                        kubectl set image deployment/frontend \
                            frontend=faizan715/employee-frontend:$IMAGE_TAG \
                            -n employee-app

                        echo "Waiting for deployments..."

                        kubectl rollout status deployment/database -n employee-app
                        kubectl rollout status deployment/backend -n employee-app
                        kubectl rollout status deployment/frontend -n employee-app

                        echo "Deployment completed successfully!"

                        echo "Pods:"
                        kubectl get pods -n employee-app

                        echo "Services:"
                        kubectl get services -n employee-app
                    '''
                }
            }
        }
    }
}
